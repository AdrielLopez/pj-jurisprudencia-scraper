{
  "name": "pj-jurisprudencia-scraper",
  "version": "1.0.0",
  "description": "Scraper HTTP en TypeScript para Jurisprudencia Nacional Sistematizada del Poder Judicial del Perú",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "start": "tsx src/index.ts",
    "scrape:pj": "tsx src/index.ts --source pj",
    "scrape:oefa": "tsx src/index.ts --source oefa",
    "retry:failed": "tsx src/index.ts --source pj --retry-failed",
    "test": "tsx --test test/cli.test.ts test/http-client.test.ts test/jsf-parser.test.ts test/proxy.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "scraper",
    "typescript",
    "jurisprudencia",
    "peru",
    "jsf"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "domhandler": "^5.0.3",
    "http-cookie-agent": "^7.0.4",
    "https-proxy-agent": "^5.0.1",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
